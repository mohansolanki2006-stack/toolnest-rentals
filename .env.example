# Server-only variables. Add production values in Vercel, never in source control.
# Create an Upstash Redis database through Vercel Storage; keep eviction disabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Use unique random secrets (at least 32 characters). Staff password minimum is 16.
TOOLNEST_STAFF_PASSWORD=
CRON_SECRET=

# Meta WhatsApp Cloud API. Leave sending off until templates and test recipient are ready.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# INR for each started 24-hour period after 6 PM IST on the return date.
LATE_FEE_PER_DAY=50
